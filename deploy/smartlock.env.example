# 複製成專案根目錄的 smartlock.env 再修改：cp deploy/smartlock.env.example smartlock.env
# 這個檔可能含機密（PIN、之後的 LINE token），已列入 .gitignore，不要推上 GitHub。

# 網頁 PIN 的初始值（QR code 開著時一定要設）
# 之後可以在手機「設定 → 變更 PIN」修改，改過就以 pin.json 為準，這行不再使用
CONTROL_PIN=1234

# Arduino 還沒接時先用模擬，接上後改成 0 或刪掉這行
SIM_ARDUINO=1

# 網頁埠號
WEB_PORT=5050

# 背景服務預設不開視窗；想在 Pi 螢幕上顯示請改用 install_service.sh --desktop
SHOW_WINDOW=0

# 其他可調參數（取消註解即可）
# FACE_THRESHOLD=50      # 人臉距離門檻（SFace，越小越嚴格；舊版 LBPH 的 70 不適用）
# REQUIRE_GESTURE=1
# ALLOWED_GESTURES=Thumb_Up,Victory
# ARDUINO_PORT=/dev/ttyACM0
# ENABLE_QR=1

# ---- 哨兵（陌生人自動錄影） ----
# SENTINEL=1                 # 0 = 關閉哨兵
# SENTINEL_TRIGGER=5         # 陌生人連續出現幾秒開始錄
# SENTINEL_STOP=5            # 離開幾秒後停止
# SENTINEL_MAX=60            # 單段最長秒數
# SENTINEL_COOLDOWN=300      # 兩次通知最短間隔（秒）

# ---- SD 卡容量管理（超過就自動刪最舊的錄影） ----
# RECORD_MAX_MB=2048         # 錄影總容量上限
# RECORD_MAX_DAYS=7          # 保留天數
# RECORD_MIN_FREE_MB=1024    # SD 卡剩餘空間低於此值先刪舊檔，仍不足就不錄

# ---- LINE（token 等同密碼，不要推上 GitHub） ----
# LINE_CHANNEL_TOKEN=          # Developers Console → Messaging API → Channel access token
# LINE_BASIC_ID=@your_line_id      # 官方帳號 ID，手機「設定」會顯示加好友 QR
# LINE_USER_ID=                # 只推給這個人；不設定 = 廣播給所有好友
# LINE_NOTIFY=1                # 0 = 只顯示額度，不發通知
# LINE_COOLDOWN=300            # 同一位訪客 / 開鎖失敗，幾秒內只通知一次（陌生人看 SENTINEL_COOLDOWN）
